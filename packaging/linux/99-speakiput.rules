# Let the active desktop user open the virtual keyboard used for native text
# insertion. The explicit ACL also handles systems where another udev rule
# overrides the traditional group permissions.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", TEST=="/usr/bin/setfacl", RUN+="/usr/bin/setfacl -m g:input:rw /dev/$name"
